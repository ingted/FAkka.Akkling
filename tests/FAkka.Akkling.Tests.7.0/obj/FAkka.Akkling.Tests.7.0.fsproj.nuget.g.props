    <PkgFAkka_Akkling_DistributedData Condition=" '$(PkgFAkka_Akkling_DistributedData)' == '' ">C:\Users\Administrator\.nuget\packages\fakka.akkling.distributeddata\0.12.0</PkgFAkka_Akkling_DistributedData>
    <PkgFAkka_Akkling_Cluster_Sharding Condition=" '$(PkgFAkka_Akkling_Cluster_Sharding)' == '' ">C:\Users\Administrator\.nuget\packages\fakka.akkling.cluster.sharding\0.12.0</PkgFAkka_Akkling_Cluster_Sharding>
  </PropertyGroup>
</Project>